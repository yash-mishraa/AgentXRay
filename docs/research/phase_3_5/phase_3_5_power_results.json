  "audited_claims": [
    {
      "claim_id": "CLAIM-POWER-N6-BOUND",
      "statement": "Statistical power at n=6 is bounded by <= 37.1% for large effects (d=1.25).",
      "consistency_status": "CORRECTED",
      "mathematical_classification": "SIMULATION_ESTIMATE_CONFLATED_AS_BOUND",
      "original_reported_value": "<= 37.1%",
      "audited_value": "Point simulation estimate 0.3715 (37.15%, MCSE 1.08%, 95% CI [35.03%, 39.27%]) conditional on mu=15, sigma=12, p_tie=0.05, n=6.",
      "rationale": "37.1% is not a mathematical upper bound on power. If ties are zero (p_tie=0.0), power under d=1.25 is 51.9%; for larger effects (d=2.5), power is 70.5%. The figure 37.1% is an empirical Monte Carlo point estimate under specific distributional assumptions."
    },
    {
      "claim_id": "CLAIM-POWER-N12-INTERPRETABILITY",
      "statement": "Instance-level power calculation at N=12 is 94.8% for d=1.25.",
      "consistency_status": "CORRECTED",
      "mathematical_classification": "PSEUDOREPLICATED_SENSITIVITY_CALCULATION",
      "original_reported_value": "94.8% (MCSE 0.49%)",
      "audited_value": "Hypothetical sensitivity calculation only; invalid for primary inference.",
      "rationale": "The 12 active tasks consist of 6 mechanisms evaluated at K=4 and K=8. Because pairs of configurations share the same planted failure trigger and prompt structure, treating them as N=12 independent pairs constitutes pseudoreplication. Primary inference must be conducted at the mechanism level (n=6)."
    },
    {
      "claim_id": "CLAIM-REJECTION-CONSTRAINT-N6",
      "statement": "Under two-sided alpha=0.05, the exact signed-rank test on n=6 pairs can reject H0 if and only if W=0 and m=6.",
      "consistency_status": "VERIFIED",
      "mathematical_classification": "MATHEMATICAL_THEOREM",
      "original_reported_value": "W=0 gives p=0.03125 < 0.05; W=1 gives p=0.0625 > 0.05",
      "audited_value": "VERIFIED_EXACT",
      "rationale": "With 2^6 = 64 permutation outcomes, two-sided p-value for W=0 is 2/64 = 0.03125. For W=1, p-value is 4/64 = 0.06250 > 0.05. Thus, W=0 is the only state in the rejection region."
    },
    {
      "claim_id": "CLAIM-TIE-ZERO-POWER",
      "statement": "A single tie (zero difference) among the 6 mechanisms makes rejection impossible at two-sided alpha=0.05 under Pratt filtering.",
      "consistency_status": "VERIFIED",
      "mathematical_classification": "MATHEMATICAL_THEOREM",
      "original_reported_value": "Ties reduce n to m <= 5, where min p-value is 2/32 = 0.0625 > 0.05",
      "audited_value": "VERIFIED_EXACT",
      "rationale": "Pratt filtering drops zero differences. If m <= 5, total permutations <= 32, so min two-sided p-value >= 2/32 = 0.06250 > 0.05. Rejection power is identically 0.0%."
    },
    {
      "claim_id": "CLAIM-OBSERVED-BENCHMARK-WILCOXON",
      "statement": "Observed mechanism-level Wilcoxon signed-rank test yielded W=1, p=0.50 on m=3 non-zero mechanisms.",
      "consistency_status": "VERIFIED",
      "mathematical_classification": "OBSERVED_EMPIRICAL_TEST",
      "original_reported_value": "p = 0.50",
      "audited_value": "0.50 (exact subset-sum DP permutation test)",
      "rationale": "Three mechanisms had zero differences (disqualified). Three had non-zero differences (+0.2222, +0.2222, -0.0417). For m=3, 2^3=8 perms; W=1 yields p = 4/8 = 0.50."
    }
  ],
